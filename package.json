{
  "name": "@Chelase/sky-tiptap",
  "version": "1.3.0",
  "description": "A tiptap template for Vue3 - 一个适用于 tiptap 的 Vue3 模板",
  "license": "MIT",
  "author": {
    "name": "Chelsea",
    "email": "2911996843@qq.com",
    "url": "https://github.com/Chelase"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Chelase/sky-tiptap.git"
  },
  "keywords": [
    "tiptap",
    "vue3",
    "rich-text-editor",
    "wysiwyg"
  ],
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/sky-tiptap.umd.js",
  "module": "./dist/sky-tiptap.es.js",
  "exports": {
    ".": {
      "import": "./dist/sky-tiptap.es.js",
      "require": "./dist/sky-tiptap.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run postbuild",
    "postbuild": "rimraf ./dist/assets",
    "prepack": "npm run build",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md",
    "test": "vitest run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@tiptap/extension-code-block-lowlight": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-paragraph": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-typography": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/extension-youtube": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/vue-3": "^2.27.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.1.0",
    "mitt": "^3.0.1",
    "sass": "^1.89.2",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.2",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog-cli": "^5.0.0",
    "jsdom": "^29.0.2",
    "rimraf": "^6.1.3",
    "vite": "^6.4.1",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  }
}
